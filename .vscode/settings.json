{
    "emeraldwalk.runonsave": {
        "autoClearConsole": true,
        "commands": [
            // del dest
            {
                "match": ".*",
                "cmd": "rmdir /S /Q ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2 2>nul"
            },
            // copy src to dest
            {
                "match": ".*",
                "cmd": "xcopy ${workspaceFolder}\\Contents\\mods ${env.USERPROFILE}\\Zomboid\\mods /Y /I /E /F /EXCLUDE:xclude"
            },
            // copy src/media/* from dest to dest/42.0.0
            {
                "match": ".*",
                "cmd": "xcopy ${workspaceFolder}\\Contents\\mods\\PhunLewt2\\media ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\42.0.0\\media /Y /I /E /F"
            },
            // copy src/common to dest/common
            {
                "match": ".*",
                "cmd": "xcopy ${workspaceFolder}\\Contents\\mods\\PhunLewt2\\common ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\common /Y /I /E /F"
            },
            {
                "match": ".*",
                "cmd": "del ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\42.0.0\\media\\lua\\client\\PhunLewt2\\ui\\admin.lua"
            },            
            // copy src/mod.info to dest/42.0.0/mod.info
            // {
            //     "match": ".*",
            //     "cmd": "copy ${workspaceFolder}\\Contents\\mods\\PhunLewt2\\42.0.0\\mod.info ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\42.0.0\\mod.info /Y"
            // },
            // copy src/poster to dest/42.0.0/poster
            {
                "match": ".*",
                "cmd": "copy ${workspaceFolder}\\Contents\\mods\\PhunLewt2\\poster.png ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\42.0.0\\poster.png /Y"
            },
            // copy src/icon to dest/42.0.0/icon
            {
                "match": ".*",
                "cmd": "copy ${workspaceFolder}\\Contents\\mods\\PhunLewt2\\icon.png ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2\\42.0.0\\icon.png /Y"
            },
            // remove workshop/*
            {
                "match": ".*",
                "cmd": "rmdir /S /Q ${env.USERPROFILE}\\Zomboid\\Workshop\\PhunLewt2 2>nul"
            },
            // copy src to workshop
            {
                "match": ".*",
                "cmd": "xcopy ${workspaceFolder} ${env.USERPROFILE}\\Zomboid\\Workshop\\PhunLewt2 /Y /I /E /F /EXCLUDE:xclude"
            },
            // copy dest to workshop
            {
                "match": ".*",
                "cmd": "xcopy ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2 ${env.USERPROFILE}\\Zomboid\\Workshop\\PhunLewt2\\Contents\\mods\\PhunLewt2 /Y /I /E /F"
            },
            // del pz41
            {
                "match": ".*",
                "cmd": "rmdir /S /Q ${env.USERPROFILE}\\pz41\\mods\\PhunLewt2 2>nul"
            },
            // copy dest to pz41
            {
                "match": ".*",
                "cmd": "xcopy ${env.USERPROFILE}\\Zomboid\\mods\\PhunLewt2 ${env.USERPROFILE}\\pz41\\mods\\PhunLewt2 /Y /I /E /F /EXCLUDE:xclude"
            },

        ]
    },
    "editor.formatOnSave": true,
    "github.gitAuthentication": true,
    "github.gitProtocol": "ssh"
}